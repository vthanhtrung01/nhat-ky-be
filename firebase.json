{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "predeploy": ["node scripts/build-posts.js"],
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "LICENSE",
      "package.json",
      "package-lock.json",
      "README.md",
      "backups/**",
      "tests/**",
      "tests-rules/**",
      "scripts/**",
      "**/.*",
      "*.log",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html|webmanifest|md|json)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": false }
  }
}
